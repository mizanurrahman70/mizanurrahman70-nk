{
  "color": {
    "background": "#FAFAF7",
    "surface": "#FFFFFF",
    "muted": "#F1F0EB",
    "foreground": "#1A1A17",
    "foreground-muted": "#57564F",
    "border": "#DEDCD3",
    "primary": "#1F4D3A",
    "primary-foreground": "#FFFFFF",
    "accent": "#A3471F",
    "accent-foreground": "#FFFFFF",
    "inverse": "#1A1A17",
    "inverse-foreground": "#FAFAF7",
    "ring": "#C2410C",
    "success": "#067647",
    "danger": "#B42318"
  },
  "font": {
    "heading": ["var(--brand-font-heading)", "Georgia", "serif"],
    "body": ["var(--brand-font-body)", "system-ui", "sans-serif"]
  },
  "fontSize": {
    "xs": ["0.75rem", { "lineHeight": "1rem" }],
    "sm": ["0.875rem", { "lineHeight": "1.25rem" }],
    "base": ["1rem", { "lineHeight": "1.5rem" }],
    "lg": ["1.25rem", { "lineHeight": "1.75rem" }],
    "xl": ["1.5rem", { "lineHeight": "2rem" }],
    "2xl": ["2rem", { "lineHeight": "2.5rem", "letterSpacing": "-0.01em" }],
    "3xl": ["3rem", { "lineHeight": "3.5rem", "letterSpacing": "-0.02em" }],
    "4xl": ["4rem", { "lineHeight": "4.5rem", "letterSpacing": "-0.02em" }]
