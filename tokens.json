  "spacing": {
    "0": "0px",
    "px": "1px",
    "1": "0.25rem",
    "2": "0.5rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem",
    "touch": "2.75rem"
  },
  "radius": {
    "none": "0px",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "1rem",
    "full": "9999px"
  },
  "container": {
    "prose": "40rem",
    "wide": "56rem",
